# DB 接続文字列 (Prisma 7 はドライバアダプタ経由で接続するため必須)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_ops"

# プラットフォーム管理者トークン (テナントの作成・列挙 POST/GET /api/v1/tenants 専用。32 文字以上の乱数。
# 未設定ならプラットフォーム管理者の操作は誰もできない = fail-closed)。生成例: openssl rand -base64 48
PLATFORM_ADMIN_TOKEN=""

# プロキシ (Step2) の上流。**クライアントからは決して受け取らない** — 接続先も資格情報もここだけが決める。
# 接続先を省略すると公式のエンドポイントへ向く。差し替えは https か、非本番のループバック http だけを受け付ける。
#
# **公開する前に必ず読むこと**: Step2 時点ではプロキシ経路にレート制限も予算の強制も無い
# (ADR-0007「残る宿題」。Agent.budgetMicroUsd を中継時に見るのは Step4)。有効な API キーを持つ
# テナントは、ここに入れた資格情報で上限なく課金を積める。したがって今日効く歯止めは 2 つだけ:
#   1. ベンダー側の月次利用上限 (spend limit) を設定する
#   2. 前段のリバースプロキシでレート制限を掛ける
#      (アプリ側で絞るのは ADR-0007「残る宿題」のとおり Step4。認証経路のレート制限は ADR-0005 の Step6)
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# 品質評価 (Step3) の採点に使う LLM。**未設定なら src/lib/constants.ts の既定値を使う**
# (JUDGE_DEFAULT_PROVIDER / JUDGE_DEFAULT_MODEL)。接続先と資格情報は上のプロキシの設定を共有する
# ので、ここで指定するのは「どのプロバイダのどのモデルに採点させるか」だけ。
#
# **綴りを間違えたプロバイダ名は既定へ倒さず 503 にする** — 意図しないプロバイダに採点させない
# ため (fail-closed。ADR-0009)。値は anthropic か openai。
#
# **評価の呼び出しは UsageEvent に記録しない** (利用者の呼び出しと混ぜると日次集計と Step4 の
# コスト超過ルールが評価のたびに跳ねる)。上のプロキシと同じ資格情報を使うので、**評価を回すと
# ベンダー側の課金は発生する** — 上限 (spend limit) は必ず設定しておくこと。
JUDGE_PROVIDER=""
JUDGE_MODEL=""

# 監査ログ (Step4) の改ざん検知に使う HMAC 鍵。32 文字以上の乱数。生成例: openssl rand -base64 48
#
# **未設定・短すぎは 503 で落ちる (fail-closed)。** 監査ログを書く操作 (ルールの発火による自動停止・
# 復帰・ルールの設定変更) はこの鍵が無いと実行できない。鍵なしのハッシュで代用しないのは、DB への
# 書き込み権限を得た相手が値を書き換えたうえで連鎖をまるごと作り直せて、検知の役に立たなくなるため。
#
# **鍵を変えると、それ以前に書いた行は検証できなくなる** (過去の行は古い鍵で計算したハッシュを
# 持っているため)。鍵の交換が必要になったときは、交換した時点を運用記録に残すこと。
AUDIT_HMAC_SECRET=""

# ガードレール (Step4) の通知先。**どちらも省略可**で、設定しなければ通知は送らずインシデントの
# 記録と自動停止だけを行う (通知の失敗や未設定で停止を取り消さない)。
#
# **宛先はテナントから受け取らず、ここだけが決める** (上流 LLM の接続先と同じ流儀。ADR-0007)。
# 利用者が入れた URL へサーバが要求を出す形にすると SSRF の入口になるため、Step4 では運用者が
# 設定する 1 組に絞っている。テナントごとの宛先管理は Step5/6 の設定画面と一緒に入れる。
# 受け付けるのは https か、非本番のループバック http だけ。リダイレクトは追わない。
NOTIFY_WEBHOOK_URL=""
# メール通知の中継先 (同じ形の署名付き POST を送る)。SMTP は持ち込まない (ADR-0010)
NOTIFY_MAIL_WEBHOOK_URL=""
# 通知に付ける HMAC 署名 (X-Agent-Ops-Signature) の鍵。32 文字以上。
# **未設定なら通知を送らない** — 署名なしの通知は受け手がなりすましと区別できないので、
# 「署名できないなら送らない」側に倒す (§9 fail-closed)
NOTIFY_SIGNING_SECRET=""
