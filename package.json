{
  "name": "agent-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:contract": "node scripts/require-contract-env.mjs && vitest run tests/data --no-file-parallelism",
    "gen": "openapi-typescript openapi/openapi.yaml -o src/generated/openapi.d.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "bench:proxy": "tsx scripts/bench-proxy.ts",
    "bench:usage": "tsx scripts/bench-usage-aggregate.ts",
    "gate:step0": "node scripts/gate-step0.mjs",
    "gate:step1": "node scripts/gate-step1.mjs",
    "gate:step2": "node scripts/gate-step2.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "next": "^16.3.4",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
